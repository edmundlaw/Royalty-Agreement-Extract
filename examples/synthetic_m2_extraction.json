    {
      "evidence_id": "EV04",
      "passage_id": "DOC-dc937b59892604f5a8:P000004",
      "quote": "3.1 Running Royalty. Licensee must pay 6% of Net Sales for the first $500,000 and 4% of Net Sales above that threshold.",
