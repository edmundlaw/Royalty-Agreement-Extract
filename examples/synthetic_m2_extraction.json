    },
    {
      "evidence_id": "EV05",
      "passage_id": "DOC-dc937b59892604f5a8:P000005",
      "quote": "3.2 Sublicense Fees. Licensee shall pay 25% of sublicense receipts up to $250,000 and 10% thereafter, according to Schedule B.",
      "role": "OTHER"
    },
    {
      "evidence_id": "EV06",
      "passage_id": "DOC-dc937b59892604f5a8:P000006",
      "quote": "4.1 Late Payment. Interest accrues at 1.5% monthly on overdue amounts.",
      "role": "OTHER"
    },
    {
      "evidence_id": "EV07",
      "passage_id": "DOC-dc937b59892604f5a8:P000007",
      "quote": "5.1 Adjustment. Earned compensation will be reduced according to Section 7.2 when patent claims expire.",
